# ==============================================================================
# FinCore Nexus — Environment Variable Configuration Template
# Copy this file to .env and configure secrets prior to deployment.
# ==============================================================================

# Database Credentials
POSTGRES_USER=fincore
POSTGRES_PASSWORD=fincore_dev
POSTGRES_DB=fincore

# Keycloak Single Sign-On (SSO) Administration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_change_me

# Staff Role Passwords (Development Defaults)
FINCORE_TELLER_PASSWORD=Teller@123
FINCORE_MANAGER_PASSWORD=Manager@123
FINCORE_ADMIN_PASSWORD=Admin@123

# KYC 256-Bit AES Encryption Secret Key (32-byte string)
# Must be customized in non-dev environments (KYC service refuses startup with default key)
KYC_AES_SECRET_KEY=FinCoreNexusKycSecretKey256BitSecure

# Messaging & Cache Infrastructure
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend Authentication Mode (basic | keycloak)
VITE_AUTH_MODE=basic
VITE_API_URL=http://localhost:8080/api
